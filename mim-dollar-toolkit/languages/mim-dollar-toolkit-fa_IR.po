#. Plugin Name of the plugin
#: mim-dollar-toolkit.php includes/class-admin.php:24
#: includes/class-admin.php:25 includes/class-admin.php:95
msgid "MiM Dollar Toolkit"
msgstr "تولکیت دلاری میم‌اسکریپت"

#. Plugin URI of the plugin
#: mim-dollar-toolkit.php
msgid "https://github.com/Mohammad78SD/mim-dollar-toolkit"
msgstr ""

#. Description of the plugin
#: mim-dollar-toolkit.php
msgid ""
"USD-based Toman pricing, pre-invoice checkout (no online payment), SMS "
"notifications (FarazSMS) and mobile OTP login for Iranian WooCommerce stores."
msgstr ""
"قیمت‌گذاری تومانی بر پایهٔ دلار، پیش‌فاکتور به‌جای پرداخت آنلاین، اعلان‌های "
"پیامکی (فراز اس‌ام‌اس) و ورود با کد یک‌بارمصرف موبایل برای فروشگاه‌های ووکامرس "
"ایرانی."

#. Author of the plugin
#: mim-dollar-toolkit.php
msgid "MiM Script"
msgstr "میم‌اسکریپت"

#. Author URI of the plugin
#: mim-dollar-toolkit.php
msgid "https://mimscript.com"
msgstr ""

